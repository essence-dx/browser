# //zen/BUILD.gn — Zen Browser layer on top of Chromium's //chrome.
#
# Replaces the previous engine-chromium/BUILD.gn, which was not valid GN:
#   - it listed .html/.css/.json files under source_set(sources = [...]),
#     but GN sources must be compilable inputs, so the target could never
#     generate;
#   - it depended on //zen/adapters:tabs, :windows and :session — none of
#     those existed as GN targets, so the dep graph was unresolvable;
#   - shell_app and shell_actors were declared and never referenced.
#
# This file is copied to <chromium>/src/zen/BUILD.gn by bootstrap.sh. It cannot
# be generated outside a Chromium checkout: every dep below resolves inside
# that tree, so `gn gen` is only meaningful once the checkout exists.
#
# Integration: //chrome/browser/BUILD.gn must add "//zen" to the deps of the
# target that links chrome.exe. zen_layer.cc holds the entry point.

import("//build/config/features.gni")

static_library("zen") {
  sources = [
    "zen_layer.cc",
    "zen_layer.h",
    "zen_tab_model.cc",
    "zen_tab_model.h",
    "zen_vertical_tab_strip.cc",
    "zen_vertical_tab_strip.h",
  ]

  deps = [
    "//base",
    "//chrome/browser",
    "//components/sessions",
    "//content/public/browser",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
    "//ui/views/controls",
    "//url",
  ]
}

# Prefs and policy live in engine-chromium/{prefs.json,policy/}. Chromium reads
# them through the normal pref-registration path, not as compile inputs, so
# they are attached as data rather than listed in sources.
group("zen_config") {
  data = [
    "//zen/prefs.json",
    "//zen/policy/policy.json",
  ]
}
