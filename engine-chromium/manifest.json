{
  "manifest_version": 3,
  "name": "Zen Browser Shell (Chromium)",
  "version": "1.22.0",
  "description": "Zen vertical tabs, workspaces, and split view on Chromium.",
  "action": {
    "default_popup": "shell/tabs.html"
  },
  "background": {
    "service_worker": "shell/background.js"
  },
  "permissions": ["tabs", "tabGroups", "sessions", "storage", "windows", "history", "scripting", "identity"],
  "host_permissions": ["<all_urls>"],
  "omnibox": {
    "keyword": "zen"
  },
  "chrome_url_overrides": {
    "newtab": "shell/tabs.html"
  }
}
